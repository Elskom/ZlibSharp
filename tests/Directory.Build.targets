<Project>

  <ItemGroup>
    <None Include="SourceText.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="CompressedText.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="FluentAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="Coverage" AfterTargets="VSTest">
    <ReportGenerator ProjectDirectory="$(MSBuildProjectDirectory)" TargetDirectory="$(MSBuildProjectDirectory)/coverage" />
  </Target>

</Project>
